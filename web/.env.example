# Public analytics and Search Console. Leave blank locally.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Incoming hotel performance audit and Meta Ads enquiry requests are POSTed here as JSON.
# Required in production. In local development, submissions are logged to the server console.
AUDIT_WEBHOOK_URL=

# Local CRM database. Relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Public site origin used in PIN-reset links.
CRM_BASE_URL="http://localhost:3000"

# Leave blank until the live notification address is confirmed.
LEAD_NOTIFICATION_EMAIL=

# Optional SMTP for device codes, PIN reset, and lead alerts.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Server-side Google Maps Platform key for /tools/hotel-review-link
# Do not prefix with NEXT_PUBLIC_. The browser never receives this value.
#
# Enable in Google Cloud:
#   1. Places API (New)  — required for Text Search and Place Details
#
# The tool needs:
#   - places:searchText
#   - Place Details (New), including googleMapsLinks.writeAReviewUri
#
# Key restrictions:
#   - Application: IP addresses for the server (leave unset for local dev)
#   - API: Places API (New) only
#   - Do not restrict this server key by HTTP referrer
#
# Billing: Text Search + Place Details Pro (googleMapsLinks)
GOOGLE_MAPS_API_KEY=
