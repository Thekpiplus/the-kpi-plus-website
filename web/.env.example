# Public analytics and Search Console. Leave blank locally.
# Prefer installing GA4 inside GTM (CMS → ตั้งค่าเว็บ → Google Tag Manager).
# NEXT_PUBLIC_GTM_ID is only a deploy fallback when the CMS setting is empty.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# CMS → Website Analytics (GA4 Data API). Property ID can also be saved in ตั้งค่าเว็บ.
# Prefer a local JSON file (gitignored): web/.ga4-service-account.json
# Or paste the full service-account JSON as a single-line string (escape newlines as \n).
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_FILE=
GA4_SERVICE_ACCOUNT_JSON=

# Incoming hotel performance audit and Meta Ads enquiry requests are POSTed here as JSON.
# Required in production. In local development, submissions are logged to the server console.
AUDIT_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Databases — keep local and online completely separate
# -----------------------------------------------------------------------------
# LOCAL (npm run dev): put DATABASE_URL in `.env.local` (gitignored), DB name
# `kpi_plus_dev` on AppServ. Run once: `npm run db:local`
#
# ONLINE (Hostinger): set DATABASE_URL only in hPanel → Node.js → Environment
# variables (host 127.0.0.1 on the server). Never paste the live URL into
# `.env` / `.env.local` for daily work.
#
# Dev safety: non-production refuses remote MySQL hosts unless ALLOW_REMOTE_DB=1.
# -----------------------------------------------------------------------------
# .env.local example:
# DATABASE_URL="mysql://root:YOUR_PASSWORD@127.0.0.1:3306/kpi_plus_dev?sessionVariables=sql_mode='ANSI_QUOTES'"
DATABASE_URL="mysql://root:YOUR_PASSWORD@127.0.0.1:3306/kpi_plus_dev?sessionVariables=sql_mode='ANSI_QUOTES'"
ALLOW_REMOTE_DB=

# Public site origin used in PIN-reset links.
CRM_BASE_URL="http://localhost:3000"

# Partner portal field encryption. Set a long random secret in production.
PARTNER_DATA_KEY=

# Leave blank until the live notification address is confirmed.
LEAD_NOTIFICATION_EMAIL=

# Optional SMTP for device codes, PIN reset, and lead alerts.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Server-side Google Maps Platform key for /tools/hotel-review-link
# Do not prefix with NEXT_PUBLIC_. The browser never receives this value.
#
# Enable in Google Cloud:
#   1. Places API (New)  — required for Text Search and Place Details
#
# The tool needs:
#   - places:searchText
#   - Place Details (New), including googleMapsLinks.writeAReviewUri
#
# Key restrictions:
#   - Application: IP addresses for the server (leave unset for local dev)
#   - API: Places API (New) only
#   - Do not restrict this server key by HTTP referrer
#
# Billing: Text Search + Place Details Pro (googleMapsLinks)
GOOGLE_MAPS_API_KEY=
