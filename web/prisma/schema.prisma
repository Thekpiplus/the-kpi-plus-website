generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  phone          String    @unique
  email          String    @unique
  username       String?   @unique
  name           String
  role           String    @default("superadmin")
  modules        String    @default("")
  pinHash        String
  pinSalt        String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  partner        Partner?
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  ip        String
  userAgent String
  createdAt DateTime @default(now())
}

model TrustedDevice {
  id              String    @id @default(cuid())
  userId          String
  deviceTokenHash String    @unique
  userAgent       String
  verifiedAt      DateTime
  lastSeenAt      DateTime
}

model DeviceChallenge {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
}

model PinReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
}

model LoginAttempt {
  id        String   @id @default(cuid())
  phone     String
  email     String   @default("")
  userId    String   @default("")
  userName  String   @default("")
  role      String   @default("")
  shop      String   @default("")
  ip        String
  userAgent String   @default("")
  success   Boolean
  reason    String
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model RateLimit {
  id        String   @id
  count     Int      @default(0)
  resetAt   DateTime
}

model Stage {
  id        String  @id @default(cuid())
  name      String
  nameTh    String
  sortOrder Int
  isWon     Boolean @default(false)
  isLost    Boolean @default(false)
  leads     Lead[]
}

model Lead {
  id               String     @id @default(cuid())
  stageId          String
  stage            Stage      @relation(fields: [stageId], references: [id])
  ownerId          String?
  contactName      String
  businessName     String     @default("")
  businessType     String     @default("")
  phone            String     @default("")
  phoneNormalized  String     @default("")
  email            String     @default("")
  location         String     @default("")
  website          String     @default("")
  services         String     @default("[]")
  source           String
  formName         String     @default("")
  pageUrl          String     @default("")
  message          String     @default("")
  rawPayload       String     @default("")
  utm              String     @default("{}")
  locale           String     @default("th")
  estimatedValue   Float?
  decisionDate     DateTime?
  lastContactAt    DateTime?
  nextActivityAt   DateTime?
  outcome          String     @default("")
  outcomeReason    String     @default("")
  noFollowUp       Boolean    @default(false)
  noFollowUpReason String     @default("")
  partnerId        String?
  partner          Partner?   @relation(fields: [partnerId], references: [id])
  referralId       String?
  referralStatus   String     @default("")
  referredAt       DateTime?
  referralAcceptedAt DateTime?
  protectionEndsAt DateTime?
  creditNote       String     @default("")
  archivedAt       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  activities       Activity[]
  events           LeadEvent[]
  notifications    Notification[]
  attachments      Attachment[]
  payments         PaymentRecord[]
  commissions      CommissionItem[]
  referrals        Referral[]
  creditDecisions  LeadCreditDecision[]
}

model Activity {
  id            String    @id @default(cuid())
  leadId        String
  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ownerId       String?
  type          String
  title         String
  dueAt         DateTime
  status        String    @default("open")
  notes         String    @default("")
  outcome       String    @default("")
  firstResponse Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
}

model LeadEvent {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  type      String
  detail    String
  createdAt DateTime @default(now())
}

model Notification {
  id            String    @id @default(cuid())
  leadId        String
  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind          String
  toEmail       String
  status        String
  error         String    @default("")
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime  @default(now())
}

model Attachment {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  filename  String
  mime      String
  size      Int
  path      String
  createdAt DateTime @default(now())
}

model Partner {
  id               String               @id @default(cuid())
  userId           String?              @unique
  user             User?                @relation(fields: [userId], references: [id])
  type             String
  legalName        String
  displayName      String
  email            String
  phone            String
  phoneNormalized  String               @default("")
  address          String               @default("")
  taxIdEncrypted   String               @default("")
  taxIdLast4       String               @default("")
  pendingLegalName String               @default("")
  pendingTaxIdEncrypted String          @default("")
  pendingTaxIdLast4 String              @default("")
  tier             String
  status           String               @default("pending")
  kycStatus        String               @default("unverified")
  approvedAt       DateTime?
  renewsAt         DateTime?
  termsVersion     String               @default("")
  termsAcceptedAt  DateTime?
  reviewNote       String               @default("")
  reviewedAt       DateTime?
  reviewedById     String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  leads            Lead[]
  banks            PartnerBankAccount[]
  documents        PartnerDocument[]
  referrals        Referral[]
  commissions      CommissionItem[]
  payouts          Payout[]
  audits           AuditLog[]
}

model PartnerBankAccount {
  id                     String    @id @default(cuid())
  partnerId              String
  partner                Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  bankName               String
  accountName            String
  accountNumberEncrypted String
  accountLast4           String
  status                 String
  approvedAt             DateTime?
  approvedById           String?
  createdAt              DateTime  @default(now())
}

model PartnerDocument {
  id        String   @id @default(cuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  kind      String
  filename  String
  mime      String
  size      Int
  path      String
  checksum  String
  createdAt DateTime @default(now())
}

model Referral {
  id               String           @id @default(cuid())
  partnerId        String
  partner          Partner          @relation(fields: [partnerId], references: [id])
  leadId           String?
  lead             Lead?            @relation(fields: [leadId], references: [id])
  status           String           @default("draft")
  businessName     String
  contactName      String
  phone            String
  email            String           @default("")
  need             String
  submittedAt      DateTime?
  reviewedAt       DateTime?
  acceptedAt       DateTime?
  protectionEndsAt DateTime?
  rejectedReason   String           @default("")
  creditNote       String           @default("")
  ownerId          String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  commissions      CommissionItem[]
}

model PaymentRecord {
  id               String           @id @default(cuid())
  leadId           String
  lead             Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  serviceMonth     String
  serviceName      String
  grossSatang      Int
  discountSatang   Int              @default(0)
  vatSatang        Int              @default(0)
  ineligibleSatang Int              @default(0)
  receivedSatang   Int
  confirmed        Boolean          @default(false)
  confirmedAt      DateTime?
  confirmedById    String?
  kind             String           @default("receipt")
  note             String           @default("")
  createdAt        DateTime         @default(now())
  commissions      CommissionItem[]
}

model CommissionRule {
  id          String   @id @default(cuid())
  version     Int      @unique
  payload     String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  createdById String?
}

model CommissionItem {
  id               String         @id @default(cuid())
  partnerId        String
  partner          Partner        @relation(fields: [partnerId], references: [id])
  leadId           String
  lead             Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  referralId       String?
  referral         Referral?      @relation(fields: [referralId], references: [id])
  paymentId        String?
  payment          PaymentRecord? @relation(fields: [paymentId], references: [id])
  ruleVersion      Int
  partnerTier      String
  serviceMonth     String
  monthIndex       Int
  status           String
  eligibleSatang   Int
  rateBps          Int
  calculatedSatang Int
  paidSatang       Int            @default(0)
  adjustmentSatang Int            @default(0)
  remainingSatang  Int
  exceptionReason  String         @default("")
  holdReason       String         @default("")
  snapshot         String         @default("{}")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  payoutLines      PayoutLine[]
}

model Payout {
  id                String       @id @default(cuid())
  partnerId         String
  partner           Partner      @relation(fields: [partnerId], references: [id])
  status            String       @default("draft")
  dueDate           DateTime
  paidAt            DateTime?
  method            String       @default("")
  reference         String       @default("")
  grossSatang       Int
  adjustmentSatang  Int          @default(0)
  withholdingSatang Int          @default(0)
  netSatang         Int
  bankSnapshot      String       @default("{}")
  note              String       @default("")
  createdAt         DateTime     @default(now())
  lines             PayoutLine[]
}

model PayoutLine {
  id           String         @id @default(cuid())
  payoutId     String
  payout       Payout         @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  commissionId String
  commission   CommissionItem @relation(fields: [commissionId], references: [id])
  amountSatang Int
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  partnerId  String?
  partner    Partner? @relation(fields: [partnerId], references: [id])
  entityType String
  entityId   String
  action     String
  detail     String
  createdAt  DateTime @default(now())
}

model LeadCreditDecision {
  id              String   @id @default(cuid())
  leadId          String
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  winnerPartnerId String?
  reason          String
  decidedById     String
  createdAt       DateTime @default(now())
}

model CmsDocument {
  id               String    @id @default(cuid())
  kind             String
  title            String    @db.VarChar(500)
  slug             String    @db.VarChar(255)
  locale           String    @default("th")
  status           String    @default("draft")
  template         String    @default("general")
  excerpt          String    @default("") @db.Text
  body             String    @db.LongText
  featuredImage    String    @default("") @db.VarChar(500)
  imageAlt         String    @default("") @db.VarChar(500)
  category         String    @default("")
  tags             String    @default("") @db.Text
  author           String    @default("")
  seoTitle         String    @default("") @db.VarChar(500)
  metaDescription  String    @default("") @db.Text
  canonical        String    @default("") @db.VarChar(500)
  ogImage          String    @default("") @db.VarChar(500)
  noindex          Boolean   @default(false)
  showInMenu       Boolean   @default(false)
  menu             String    @default("none")
  menuLabel        String    @default("")
  menuParent       String    @default("")
  menuPosition     Int       @default(0)
  publishedAt      DateTime?
  scheduledAt      DateTime?
  trashedAt        DateTime?
  updatedBy        String    @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([kind, slug, locale])
}

model CmsMedia {
  id        String   @id @default(cuid())
  filename  String
  path      String
  alt       String   @default("")
  caption   String   @default("")
  mime      String
  size      Int
  createdAt DateTime @default(now())
}

model CmsRedirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model CmsSetting {
  id        String   @id
  value     String   @db.LongText
  updatedAt DateTime @updatedAt
}

model CmsContact {
  id                 String   @id @default(cuid())
  label              String   @default("")
  companyNameTh      String   @default("") @db.VarChar(255)
  companyNameEn      String   @default("") @db.VarChar(255)
  addressTh          String   @db.Text
  addressEn          String   @db.Text
  phone              String   @default("")
  secondaryPhone     String   @default("")
  email              String   @default("")
  whatsappNumber     String   @default("")
  googleMapsUrl      String   @default("") @db.VarChar(1000)
  googleMapsEmbed    String   @default("") @db.Text
  hoursTh            String   @default("") @db.VarChar(255)
  hoursEn            String   @default("") @db.VarChar(255)
  facebook           String   @default("") @db.VarChar(500)
  instagram          String   @default("") @db.VarChar(500)
  linkedin           String   @default("") @db.VarChar(500)
  tiktok             String   @default("") @db.VarChar(500)
  lineHref           String   @default("") @db.VarChar(500)
  locationImage      String   @default("") @db.VarChar(500)
  locationImageAlt   String   @default("") @db.VarChar(500)
  consultantImage    String   @default("") @db.VarChar(500)
  consultantImageAlt String   @default("") @db.VarChar(500)
  adminNotes         String   @default("") @db.Text
  isPrimary          Boolean  @default(false)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isPrimary])
}

model CmsCaseStudy {
  id                     String    @id @default(cuid())
  department             String    @default("revenue")
  title                  String    @db.VarChar(500)
  slug                   String    @db.VarChar(255)
  locale                 String    @default("th")
  shortDescription       String    @default("") @db.Text
  clientName             String    @default("")
  clientNameApproved     Boolean   @default(false)
  anonymisedLabel        String    @default("")
  hotelType              String    @default("")
  location               String    @default("")
  serviceArea            String    @default("")
  challenge              String    @default("") @db.Text
  analysis               String    @default("") @db.Text
  actionPlan             String    @default("") @db.Text
  result                 String    @default("") @db.Text
  metricsJson            String    @default("[]") @db.LongText
  measurementPeriod      String    @default("")
  baselinePeriod         String    @default("")
  dataStatus             String    @default("anonymised")
  workflowStatus         String    @default("draft")
  isPublished            Boolean   @default(false)
  isFeatured             Boolean   @default(false)
  coverImage             String    @default("") @db.VarChar(500)
  coverImageAlt          String    @default("") @db.VarChar(500)
  coverImageStatus       String    @default("placeholder")
  reportPreview          String    @default("") @db.VarChar(500)
  reportPreviewAlt       String    @default("") @db.VarChar(500)
  chartJson              String    @default("") @db.LongText
  testimonialJson        String    @default("") @db.Text
  methodologyNote        String    @default("") @db.Text
  sourceNotes            String    @default("") @db.Text
  relatedArticleIds      String    @default("[]") @db.Text
  seoTitle               String    @default("") @db.VarChar(500)
  metaDescription        String    @default("") @db.Text
  clientLogo             String    @default("") @db.VarChar(500)
  clientLogoPublishable  Boolean   @default(false)
  adminNotes             String    @default("") @db.Text
  publishedAt            DateTime?
  trashedAt              DateTime?
  updatedBy              String    @default("")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([slug, locale])
  @@index([department])
  @@index([isPublished])
  @@index([trashedAt])
}

model CmsClientLogo {
  id              String   @id @default(cuid())
  name            String   @db.VarChar(255)
  filePath        String   @default("") @db.VarChar(500)
  clientName      String   @default("") @db.VarChar(255)
  anonymisedLabel String   @default("") @db.VarChar(255)
  altText         String   @default("") @db.VarChar(500)
  sortOrder       Int      @default(0)
  permission      String   @default("pending")
  isActive        Boolean  @default(false)
  adminNotes      String   @default("") @db.Text
  updatedBy       String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([permission])
  @@index([isActive])
  @@index([sortOrder])
}

model ReservationOperation {
  id          String                     @id @default(cuid())
  reference   String                     @unique @db.VarChar(32)
  name        String                     @db.VarChar(255)
  type        String
  channel     String
  status      String                     @default("new")
  priority    String                     @default("normal")
  assigneeId  String                     @default("")
  dueAt       DateTime?
  hotelName   String                     @default("") @db.VarChar(255)
  guestName   String                     @default("") @db.VarChar(255)
  guestEmail  String                     @default("") @db.VarChar(255)
  guestPhone  String                     @default("") @db.VarChar(64)
  bookingCode String                     @default("") @db.VarChar(64)
  notes       String                     @default("") @db.Text
  closedAt    DateTime?
  escalatedAt DateTime?
  createdBy   String                     @default("")
  updatedBy   String                     @default("")
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  subtasks    ReservationSubtask[]
  comments    ReservationOpComment[]
  attachments ReservationOpAttachment[]

  @@index([status])
  @@index([type])
  @@index([channel])
  @@index([assigneeId])
  @@index([dueAt])
}

model ReservationSubtask {
  id          String                @id @default(cuid())
  operationId String
  operation   ReservationOperation  @relation(fields: [operationId], references: [id], onDelete: Cascade)
  name        String                @db.VarChar(255)
  status      String                @default("open")
  completed   Boolean               @default(false)
  dueAt       DateTime?
  assigneeId  String                @default("")
  priority    String                @default("normal")
  comments    String                @default("") @db.Text
  sortOrder   Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([operationId])
}

model ReservationOpComment {
  id          String               @id @default(cuid())
  operationId String
  operation   ReservationOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  authorId    String
  body        String               @db.Text
  createdAt   DateTime             @default(now())

  @@index([operationId])
}

model ReservationOpAttachment {
  id          String               @id @default(cuid())
  operationId String
  operation   ReservationOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  filename    String
  mime        String
  size        Int
  path        String               @db.VarChar(500)
  createdBy   String               @default("")
  createdAt   DateTime             @default(now())

  @@index([operationId])
}

model B2bPartner {
  id             String              @id @default(cuid())
  name           String              @db.VarChar(255)
  type           String
  market         String              @default("") @db.VarChar(255)
  contactPerson  String              @default("") @db.VarChar(255)
  contactChannel String              @default("") @db.VarChar(255)
  ownerId        String              @default("")
  department     String              @default("sales")
  priority       String              @default("normal")
  status         String              @default("new_lead")
  nextAction     String              @default("") @db.VarChar(500)
  nextActionAt   DateTime?
  lastContactAt  DateTime?
  notes          String              @default("") @db.Text
  hotels         String              @default("") @db.Text
  rateApproval   String              @default("draft")
  createdBy      String              @default("")
  updatedBy      String              @default("")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  contacts       B2bContact[]
  terms          B2bCommercialTerm[]
  activities     B2bActivity[]
  bookings       B2bBooking[]
  files          B2bFile[]
  notesList      B2bNote[]
  audits         B2bAudit[]

  @@index([status])
  @@index([ownerId])
  @@index([department])
  @@index([market])
  @@index([nextActionAt])
  @@index([priority])
}

model B2bContact {
  id         String     @id @default(cuid())
  partnerId  String
  partner    B2bPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name       String     @db.VarChar(255)
  role       String     @default("") @db.VarChar(255)
  email      String     @default("") @db.VarChar(255)
  phone      String     @default("") @db.VarChar(64)
  channel    String     @default("") @db.VarChar(64)
  isPrimary  Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([partnerId])
}

model B2bCommercialTerm {
  id             String     @id @default(cuid())
  partnerId      String
  partner        B2bPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  hotelName      String     @default("") @db.VarChar(255)
  ratePlan       String     @default("") @db.VarChar(255)
  commissionText String     @default("") @db.Text
  availability   String     @default("") @db.VarChar(255)
  channel        String     @default("") @db.VarChar(255)
  status         String     @default("draft")
  notes          String     @default("") @db.Text
  approvedBy     String     @default("")
  approvedAt     DateTime?
  createdBy      String     @default("")
  updatedBy      String     @default("")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([partnerId])
  @@index([status])
}

model B2bActivity {
  id          String               @id @default(cuid())
  partnerId   String
  partner     B2bPartner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type        String
  title       String               @db.VarChar(255)
  hotelName   String               @default("") @db.VarChar(255)
  dueAt       DateTime?
  status      String               @default("planned")
  notes       String               @default("") @db.Text
  ownerId     String               @default("")
  completedAt DateTime?
  closedAt    DateTime?
  escalatedAt DateTime?
  createdBy   String               @default("")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  subtasks    B2bActivitySubtask[]
  comments    B2bActivityComment[]
  files       B2bActivityFile[]

  @@index([partnerId])
  @@index([dueAt])
  @@index([status])
}

model B2bActivitySubtask {
  id         String      @id @default(cuid())
  activityId String
  activity   B2bActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  name       String      @db.VarChar(255)
  status     String      @default("planned")
  completed  Boolean     @default(false)
  dueAt      DateTime?
  assigneeId String      @default("")
  priority   String      @default("normal")
  comments   String      @default("") @db.Text
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([activityId])
}

model B2bActivityComment {
  id         String      @id @default(cuid())
  activityId String
  activity   B2bActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  authorId   String      @default("")
  body       String      @db.Text
  createdAt  DateTime    @default(now())

  @@index([activityId])
}

model B2bActivityFile {
  id         String      @id @default(cuid())
  activityId String
  activity   B2bActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  filename   String
  mime       String
  size       Int
  path       String      @db.VarChar(500)
  caption    String      @default("") @db.VarChar(500)
  createdBy  String      @default("")
  createdAt  DateTime    @default(now())

  @@index([activityId])
}

model B2bBooking {
  id          String     @id @default(cuid())
  partnerId   String
  partner     B2bPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  hotelName   String     @default("") @db.VarChar(255)
  period      String     @default("") @db.VarChar(255)
  roomNights  String     @default("") @db.VarChar(64)
  revenueText String     @default("") @db.VarChar(255)
  status      String     @default("draft")
  dataStatus  String     @default("internal")
  notes       String     @default("") @db.Text
  createdBy   String     @default("")
  updatedBy   String     @default("")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([partnerId])
}

model B2bFile {
  id        String     @id @default(cuid())
  partnerId String
